{
  "name": "dsh-sidebar",
  "displayName": "DSH Web UI Sidebar",
  "description": "Run `dsh web` and embed its Web UI into a VSCode sidebar webview via a local reverse proxy.",
  "version": "0.2.0",
  "publisher": "ckckh2023",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ckckh2023/DSH-VSCode-SideBar"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "main": "out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh",
          "title": "DSH",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dsh": [
        {
          "type": "webview",
          "id": "dsh.sidebar",
          "name": "DSH Web UI"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.start",
        "title": "DSH: 启动 Web UI",
        "icon": "$(play)"
      },
      {
        "command": "dsh.stop",
        "title": "DSH: 停止 Web UI",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dsh.openInBrowser",
        "title": "DSH: 在浏览器中打开",
        "icon": "$(globe)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dsh.start",
          "when": "view == dsh.sidebar && !dsh.running",
          "group": "navigation@1"
        },
        {
          "command": "dsh.stop",
          "when": "view == dsh.sidebar && dsh.running",
          "group": "navigation@1"
        },
        {
          "command": "dsh.openInBrowser",
          "when": "view == dsh.sidebar && dsh.running",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "DSH",
      "properties": {
        "dsh.executablePath": {
          "type": "string",
          "default": "dsh",
          "markdownDescription": "DSH 可执行文件路径，默认从 PATH 查找。"
        },
        "dsh.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "首次打开侧边栏视图时自动启动 dsh web。"
        },
        "dsh.startupTimeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "等待 dsh web 就绪的超时时间（毫秒）。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check": "node --check out/extension.js",
    "test": "node scripts/test-cookie.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.1.0",
    "esbuild": "^0.24.0"
  }
}